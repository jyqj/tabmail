{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "PROPOSAL ONLY: neither this schema nor the preparation observer authorizes runtime. Semantic descriptor/SRI/resolver checks and root approval are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy",
    "source",
    "dependency_root",
    "archive_v4_manifest_sha256",
    "selected_default_receipt_sha256",
    "selected_race_r5protocol_receipt_sha256",
    "package_json_sha256",
    "package_lock_sha256",
    "installed_candidate_manifest_sha256",
    "installed_inventory_sha256",
    "registry_tarball_manifest_sha256",
    "lifecycle_outputs_manifest_sha256",
    "platform",
    "tools",
    "execution",
    "resolution",
    "pre_validation_sha256",
    "post_validation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "const": "r5_external_dependency_runtime_v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "device",
        "inode",
        "uid",
        "mode",
        "lease_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 1
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "lease_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "device",
        "inode",
        "uid",
        "mode",
        "lease_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 1
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "lease_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "archive_v4_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_default_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_race_r5protocol_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_json_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installed_candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installed_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_tarball_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lifecycle_outputs_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_version",
        "npm_version",
        "os",
        "arch"
      ],
      "properties": {
        "node_version": {
          "type": "string"
        },
        "npm_version": {
          "type": "string"
        },
        "os": {
          "const": "linux"
        },
        "arch": {
          "const": "amd64"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_binary_sha256",
        "npm_cli_sha256",
        "vitest_cli_sha256",
        "vite_resolver_sha256",
        "config_sha256",
        "setup_sha256"
      ],
      "properties": {
        "node_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "npm_cli_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "vitest_cli_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "vite_resolver_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "setup_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "go_race_budget_seconds",
        "process_budget_seconds",
        "node_path",
        "node_options",
        "no_shadow_node_modules"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "pattern": "^/"
        },
        "go_race_budget_seconds": {
          "const": 120
        },
        "process_budget_seconds": {
          "const": 180
        },
        "node_path": {
          "const": ""
        },
        "node_options": {
          "const": ""
        },
        "no_shadow_node_modules": {
          "const": true
        }
      }
    },
    "resolution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "importer",
          "specifier",
          "conditions",
          "resolved_path",
          "classification",
          "lock_package",
          "lock_version",
          "file_sha256"
        ],
        "properties": {
          "importer": {
            "type": "string"
          },
          "specifier": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "resolved_path": {
            "type": "string",
            "pattern": "^/"
          },
          "classification": {
            "enum": [
              "builtin",
              "source",
              "external_dependency"
            ]
          },
          "lock_package": {
            "type": [
              "string",
              "null"
            ]
          },
          "lock_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "file_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "pre_validation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "post_validation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
