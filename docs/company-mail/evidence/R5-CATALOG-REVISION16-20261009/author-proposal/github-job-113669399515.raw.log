2026-10-09T04:27:25.7874267Z CATALOG16_FILE_JSON {"path": "docs/company-mail/evidence/R5-COMPATIBILITY-GATES.json", "index": 0, "total": 101, "sha256": "8981a2534a81c321c65ad2b3538458dca48ba5304391668ff2e3f1a6a882fbea", "bytes": 411943, "text": "{\n  \"scope\": \"source_inventory_and_upgrade_plan\",\n  \"task_complete\": false,\n  \"product_green\": false,\n  \"dependencies\": [\n    \"R5-P0-020\",\n    \"R5-P0-050\",\n    \"R5-P0-080\"\n  ],\n  \"dependency_acceptance\": \"operator_review_required\",\n  \"release_batches\": {\n    \"P1\": {\n      \"successor_tasks\": \"R5-P1-040/050/060/070/090/100/110/120\",\n      \"old_write_rejection\": \"Require reviewed current revision/CAS. Missing or stale revision rejects with explicit 400/409; omissions retain values; false/0/[]/null remain distinct. Current known permissive writes are baseline red, not this gate's implementation.\",\n      \"coordinated_upgrade\": \"Upgrade permissions/profile/send-policy clients to preserve omitted security fields, send current revision and handle conflicts in the same release; admin/owned API Key callers inventoried, external use remains unknown.\",\n      \"current_implementation\": \"Not implemented or runtime-certified by this inventory; consult fresh protocol target/pass evidence and successor task acceptance.\",\n      \"implemented_by_this_map\": false\n    },\n    \"P2\": {\n      \"successor_tasks\": \"R5-P2-040/050/080/100/110/140\",\n      \"old_write_rejection\": \"Remove private body/BCC/diagnostics from safe receipts even for old readers; no fallback to raw job. Submit retries preserve same command key. Migration must reject untrusted cross-tenant provenance and mark legacy_unknown; current migrator no-op does not prove future writes.\",\n      \"coordinated_upgrade\": \"Upgrade SubmissionPane, legacy-outbound client/Compatibility ReceiptFolder and external send:read Key clients together with allow-list wire DTOs; publish removed private fields as security-breaking projection; implement versioned trustworthy backfill before certifying repeat writes.\",\n      \"current_implementation\": \"Not implemented or runtime-certified by this inventory; consult fresh protocol target/pass evidence and successor task acceptance.\",\n      \"implemented_by_this_map\": false\n    },\n    \"P3\": {\n      \"successor_tasks\": \"R5-P3-020/030/040\",\n      \"old_write_rejection\": \"Expired restore rejects 409 and never extends hard_expiry. Old actions cannot clear/rebase finite deadlines. Conservative migration distinguishes NULL/unlimited/0 and protects historical personal permanent mail.\",\n      \"coordinated_upgrade\": \"Coordinate folder action clients and retention migration/release; preserve existing fields until explicit migration semantics and old-data regression prove compatibility.\",\n      \"current_implementation\": \"Not implemented or runtime-certified by this inventory; consult fresh protocol target/pass evidence and successor task acceptance.\",\n      \"implemented_by_this_map\": false\n    },\n    \"P4\": {\n      \"successor_tasks\": \"R5-P4-030/080/100/120\",\n      \"old_write_rejection\": \"Execution needs same current plan/actor/disposition; changed or expired plans reject explicit conflict and invalid successor rejects without effects. Same completed plan replay must return same receipt once; no implicit replacement successor.\",\n      \"coordinated_upgrade\": \"Upgrade UsersPage/OffboardingPanel and admin API clients together with preview/execute/receipt contract; frozen selector, successor scope and preserved sent identity cannot be weakened for old clients.\",\n      \"current_implementation\": \"Not implemented or runtime-certified by this inventory; consult fresh protocol target/pass evidence and successor task acceptance.\",\n      \"implemented_by_this_map\": false\n    },\n    \"P5\": {\n      \"successor_tasks\": \"R5-P5-030/040/050/080/090/100/110/130/140\",\n      \"old_write_rejection\": \"Reject stale draft